<Window x:Class="TradePet.App.Views.MacroCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="宏观日历"
        Width="760" Height="720" MinWidth="660" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#101720" Topmost="True">
    <Window.Resources>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8FA2B5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="宏观日历" Foreground="#F2F5F4" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="来自 MT5 内置经济日历 · 时间按当前交易服务器显示" Style="{StaticResource Muted}" Margin="0,5,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#1A2A39" CornerRadius="12" Padding="11,6" VerticalAlignment="Top">
                <TextBlock x:Name="SummaryText" Foreground="#65D9BE" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="#121C28" BorderBrush="#28394B" BorderThickness="1" CornerRadius="14" Margin="0,18,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="EventList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#263748" BorderThickness="0,0,0,1" Padding="15,13">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TimeText}" Foreground="#F2F5F4" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CountryText}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding ImportanceText}" Foreground="{Binding ImportanceColor}" FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,16,0">
                                        <TextBlock Text="{Binding Name}" Foreground="#F2F5F4" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="12" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="前值" Style="{StaticResource Muted}"/><TextBlock Text="{Binding PreviousText}" Foreground="#D9E2E8" Margin="0,5,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="预期" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ForecastText}" Foreground="#D9E2E8" Margin="0,5,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="公布" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ActualText}" Foreground="#65D9BE" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2">
            <TextBlock Text="高重要度事件会在 30 分钟和 5 分钟前由宠物提醒；公布值更新后再提醒一次。" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <Button Content="关闭" HorizontalAlignment="Right" Padding="18,7" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
