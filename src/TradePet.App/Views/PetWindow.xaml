<Window x:Class="TradePet.App.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TradePet.App.Controls"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="天禄桌宠" Width="160" Height="230" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize"
        Topmost="{Binding IsTopmost}" Opacity="{Binding PetOpacity}">
    <Window.ContextMenu>
        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     Background="#101721" BorderBrush="#3A4B60" BorderThickness="1" Padding="6"
                     MinWidth="176" OverridesDefaultStyle="True" SnapsToDevicePixels="True"
                     HasDropShadow="True" FontFamily="Microsoft YaHei UI" FontSize="14">
            <ContextMenu.Template>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.42" />
                        </Border.Effect>
                        <ScrollViewer Focusable="False" CanContentScroll="True"
                                      VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </ContextMenu.Template>
            <ContextMenu.Resources>
                <Style TargetType="{x:Type MenuItem}">
                    <Setter Property="Foreground" Value="#F2F5F4" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="15,10" />
                    <Setter Property="Margin" Value="0,2" />
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type MenuItem}">
                                <Border x:Name="MenuItemBorder" Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      TextElement.FontFamily="{TemplateBinding FontFamily}"
                                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                                      TextElement.FontWeight="{TemplateBinding FontWeight}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="MenuItemBorder" Property="Background" Value="#1B6655" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="MenuItemBorder" Property="Background" Value="#1A3B35" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="{x:Type Separator}">
                    <Setter Property="Margin" Value="8,5" />
                    <Setter Property="Height" Value="1" />
                    <Setter Property="Background" Value="#2B3A4B" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Separator}">
                                <Border Height="1" Background="{TemplateBinding Background}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.Resources>
            <MenuItem Header="今日状态" Click="ShowQuickCard_Click" />
            <MenuItem Header="交易日报" Command="{Binding ShowDailyTradingReportCommand}" />
            <MenuItem Header="宏观日历" Command="{Binding ShowMacroCalendarCommand}" />
            <MenuItem Header="交易计划" Command="{Binding ShowPlanPageCommand}" />
            <MenuItem Header="亏损区域" Command="{Binding ShowLossZonesPageCommand}" />
            <MenuItem Header="复盘分析" Command="{Binding ShowReviewPageCommand}" />
            <MenuItem Header="时间线" Command="{Binding ShowTimelinePageCommand}" />
            <MenuItem Header="设置" Command="{Binding ShowSettingsPageCommand}" />
            <Separator />
            <MenuItem Header="打开控制台" Command="{Binding ShowMainWindowCommand}" />
            <MenuItem Click="ToggleMiniPosition_Click">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="显示迷你持仓" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MiniPositionVisible}" Value="True">
                                <Setter Property="Header" Value="隐藏迷你持仓" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="暂时隐藏" Command="{Binding HidePetCommand}" />
            <Separator />
            <MenuItem Header="退出天禄交易助手" Command="{Binding ExitCommand}" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid>
        <controls:PetSpriteControl x:Name="PetSprite"
                                   Width="134" Height="146" Margin="8,0,0,0"
                                   VerticalAlignment="Bottom"
                                   Activity="{Binding PetActivity}"
                                   AtlasPath="Assets/baoer-pet/spritesheet.webp"
                                   PlaybackRate="0.65"
                                   MouseEnter="PetSprite_MouseEnter"
                                   MouseLeave="PetSprite_MouseLeave"
                                   MouseLeftButtonDown="PetSprite_MouseLeftButtonDown" />

        <primitives:Popup x:Name="QuickCardPopup"
                          Placement="Custom" CustomPopupPlacementCallback="PlaceQuickCard"
                          AllowsTransparency="True" PopupAnimation="None"
                          StaysOpen="True" Focusable="False">
        <Grid x:Name="QuickCardHost" Width="370" Height="340"
              MouseEnter="QuickCard_MouseEnter" MouseLeave="QuickCard_MouseLeave">
            <Border Width="358" Height="330" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Background="#121923" BorderBrush="#2B3746" BorderThickness="1"
                    CornerRadius="18" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="今日速览" Foreground="#F0F5F2" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding AccountLabel}" Foreground="#84918D" FontSize="10" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding ServerDateText}" Foreground="#A7B2AE" FontSize="10" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding ConnectionText}" Foreground="#54D6B2" FontSize="10"
                                       TextTrimming="CharacterEllipsis" MaxWidth="126" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="今日合计盈亏" Foreground="#96A29E" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding TotalPnl, StringFormat={}{0:+0.##;-0.##;0}}"
                                   Foreground="{Binding TotalPnlColor}"
                                   FontSize="28" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>

                    <Border Grid.Row="2" Margin="0,5,0,0" Background="#0D141D" CornerRadius="8" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="已实现" Foreground="#71807B" FontSize="9" />
                                <TextBlock Text="{Binding RealizedPnl, StringFormat={}{0:+0.##;-0.##;0}}" Foreground="{Binding RealizedPnlColor}" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="当前浮动" Foreground="#71807B" FontSize="9" />
                                <TextBlock Text="{Binding FloatingPnl, StringFormat={}{0:+0.##;-0.##;0}}" Foreground="{Binding FloatingPnlColor}" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="今日高点" Foreground="#71807B" FontSize="9" />
                                <TextBlock Text="{Binding HighWaterPnl, StringFormat={}{0:+0.##;-0.##;0}}" Foreground="{Binding HighWaterPnlColor}" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="盈利回吐" Foreground="#71807B" FontSize="9" />
                                <TextBlock Text="{Binding Giveback, StringFormat={}{0:0.##}}" Foreground="{Binding GivebackColor}" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="交易" Foreground="#71807B" FontSize="9" />
                            <TextBlock Text="{Binding TradeCount, StringFormat={}{0} 笔}" Foreground="#EAF0ED" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="盈利 / 亏损" Foreground="#71807B" FontSize="9" />
                            <TextBlock Foreground="#EAF0ED" FontWeight="SemiBold" FontSize="12">
                                <Run Text="{Binding WinCount}" Foreground="{Binding WinCountColor}"/><Run Text=" / "/><Run Text="{Binding LossCount}" Foreground="{Binding LossCountColor}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="今日连亏" Foreground="#71807B" FontSize="9" />
                            <TextBlock Text="{Binding ConsecutiveLosses, StringFormat={}{0} 笔}" Foreground="{Binding ConsecutiveLossesColor}" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="当前持仓" Foreground="#71807B" FontSize="9" />
                            <TextBlock Foreground="#EAF0ED" FontWeight="SemiBold" FontSize="12">
                                <Run Text="{Binding OpenPositionCount}"/><Run Text=" 笔 · "/><Run Text="{Binding CurrentExposure, StringFormat={}{0:0.##}}"/><Run Text=" 手"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="4" Margin="0,7,0,0" Background="#161F2A" BorderBrush="#273546" BorderThickness="1" CornerRadius="8" Padding="9,6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="交易风险" Foreground="#84918D" FontSize="10" />
                            <TextBlock Grid.Column="1" Text="{Binding RiskText}" Foreground="#F4C66A" FontWeight="SemiBold" FontSize="10"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" MaxWidth="240" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="5" Margin="0,7,0,0" Background="#10231F" CornerRadius="8" Padding="9,6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PositionCard}" Foreground="#C9D5D0" FontSize="10"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding MaximumExposure, StringFormat=日内最大 {0:0.##} 手}"
                                       Foreground="#71807B" FontSize="9" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="6" Margin="0,9,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="今日计划" Click="OpenPlan_Click" Margin="0,0,5,0" Padding="8,6" />
                        <Button Grid.Column="1" Content="打开控制台" Click="OpenConsole_Click" Margin="5,0,0,0" Padding="8,6" />
                    </Grid>
                </Grid>
            </Border>
            <Path Data="M 0,0 L 13,8 L 0,16 Z" Fill="#121923" Stroke="#2B3746"
                  Width="13" Height="16" Stretch="Fill" HorizontalAlignment="Right"
                  VerticalAlignment="Bottom" Margin="0,0,0,54" />
        </Grid>
        </primitives:Popup>

        <primitives:Popup x:Name="SpeechBubblePopup"
                          Placement="Top"
                          HorizontalOffset="0" VerticalOffset="-8"
                          AllowsTransparency="True" PopupAnimation="Fade"
                          StaysOpen="True" Focusable="False">
            <Grid Width="306" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                </Grid.RowDefinitions>
                <Border Background="#151D27" BorderBrush="#F0B85C" BorderThickness="1.5"
                        CornerRadius="16" Padding="17,13">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.55" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="天禄提醒" Foreground="#8E9A96" FontSize="10" />
                        <TextBlock Text="{Binding BubbleHeadline}" Foreground="#F7C96E"
                                   FontSize="18" FontWeight="Bold" Margin="0,3,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding BubbleDetails}" Foreground="#EEF3F1"
                                   FontSize="12" LineHeight="19" Margin="0,7,0,0"
                                   TextWrapping="Wrap" MaxWidth="270" />
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0" Visibility="{Binding IsAlertActionVisible, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="已知晓" Click="AcknowledgeAlert_Click" Padding="8,3"/>
                            <Button Content="稍后提醒" Click="SnoozeAlert_Click" Padding="8,3" Margin="6,0,0,0"/>
                            <Button Content="本笔静音" Click="MuteAlert_Click" IsEnabled="{Binding CanMuteCurrentAlert}" Padding="8,3" Margin="6,0,0,0"/>
                        </StackPanel>
                        <Border Visibility="{Binding IsBubbleLossZoneVisible, Converter={StaticResource BoolToVisibility}}"
                                Background="#2A171C" BorderBrush="#8E3E4B" BorderThickness="1"
                                CornerRadius="10" Padding="11,9" Margin="0,10,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding BubbleZoneSymbol}" Foreground="#F3F5F4"
                                               FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="亏损价格带" Foreground="#F07B7B" FontSize="10"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding BubbleZoneRangeText}" Foreground="#FFD4D8"
                                           FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding BubbleZonePositionPercent}"
                                             Height="8" Margin="0,8,0,0" Background="#4A252C"
                                             Foreground="#F07B7B" BorderThickness="0">
                                    <ProgressBar.Template>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Grid>
                                                <Border Background="#4A252C" CornerRadius="4" />
                                                <Border x:Name="PART_Indicator" Background="#F07B7B"
                                                        HorizontalAlignment="Left" CornerRadius="4" />
                                            </Grid>
                                        </ControlTemplate>
                                    </ProgressBar.Template>
                                </ProgressBar>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding BubbleZoneLowText}" Foreground="#A99699" FontSize="8" />
                                    <TextBlock Grid.Column="1" Text="{Binding BubbleZoneCurrentText}" Foreground="#FFD4D8"
                                               FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding BubbleZoneHighText}" Foreground="#A99699"
                                               FontSize="8" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding BubbleZoneCenterText}" Foreground="#CFADB1" FontSize="9" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding BubbleZoneStatsText}" Foreground="#F0A3AB" FontSize="10" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding BubbleZonePnlText}" Foreground="#CFADB1" FontSize="9" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Path Grid.Row="1" Data="M 0,0 L 18,0 L 9,11 Z"
                      Width="18" Height="11" Stretch="Fill"
                      Fill="#151D27" Stroke="#F0B85C" StrokeThickness="1.5"
                      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-1,0,0" />
            </Grid>
        </primitives:Popup>
    </Grid>
</Window>
