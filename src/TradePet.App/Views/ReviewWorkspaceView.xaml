<UserControl x:Class="TradePet.App.Views.ReviewWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True">
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveReviewCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding MarkReviewedCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding PreviousTradeCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding NextTradeCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="CompactInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,3,8,6" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
        <Style x:Key="EditorLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>
        <Style x:Key="FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="1,0,0,2" />
        </Style>
        <Style x:Key="FilterTextInput" TargetType="TextBox" BasedOn="{StaticResource CompactInput}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style x:Key="FilterComboInput" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="11,0" />
        </Style>
        <Style x:Key="FilterPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="11,0" />
        </Style>
    </UserControl.Resources>

    <TabControl Background="Transparent" BorderThickness="0" Padding="0">
        <TabItem Header="总览">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource PageCardStyle}" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <WrapPanel>
                                <StackPanel Width="190" Margin="0,0,8,6"><TextBlock Text="搜索（票号/仓位/笔记）" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索 ticket、position、笔记正文" Style="{StaticResource FilterTextInput}"/></StackPanel>
                                <StackPanel Width="110" Margin="0,0,8,6"><TextBlock Text="策略" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding Strategy}" ToolTip="策略" Style="{StaticResource FilterTextInput}"/></StackPanel>
                                <StackPanel Width="110" Margin="0,0,8,6"><TextBlock Text="形态" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding Setup}" ToolTip="形态" Style="{StaticResource FilterTextInput}"/></StackPanel>
                                <StackPanel Width="150" Margin="0,0,8,6"><TextBlock Text="标签（逗号分隔）" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding Tags}" ToolTip="多个标签用逗号分隔" Style="{StaticResource FilterTextInput}"/></StackPanel>
                                <StackPanel Width="92" Margin="0,0,8,6"><TextBlock Text="标签匹配" Style="{StaticResource FilterLabel}"/><ComboBox ItemsSource="{Binding TagModeOptions}" SelectedItem="{Binding TagMode}" ToolTip="标签任一或全部" Style="{StaticResource FilterComboInput}"/></StackPanel>
                                <StackPanel Width="100" Margin="0,0,8,6"><TextBlock Text="复盘状态" Style="{StaticResource FilterLabel}"/><ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" ToolTip="复盘状态" Style="{StaticResource FilterComboInput}"/></StackPanel>
                                <StackPanel Width="100" Margin="0,0,8,6"><TextBlock Text="执行评价" Style="{StaticResource FilterLabel}"/><ComboBox ItemsSource="{Binding AssessmentFilterOptions}" SelectedItem="{Binding AssessmentFilter}" ToolTip="执行评价" Style="{StaticResource FilterComboInput}"/></StackPanel>
                                <StackPanel Width="130" Margin="0,0,8,6"><TextBlock Text="交易想法 ID" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding CampaignFilter}" ToolTip="交易想法 ID" Style="{StaticResource FilterTextInput}"/></StackPanel>
                                <StackPanel Width="120" Margin="0,0,8,6"><TextBlock Text="排序" Style="{StaticResource FilterLabel}"/><ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" ToolTip="排序" Style="{StaticResource FilterComboInput}"/></StackPanel>
                                <StackPanel Width="120" Margin="0,0,8,6"><TextBlock Text="对照方式" Style="{StaticResource FilterLabel}"/><ComboBox ItemsSource="{Binding ComparisonModeOptions}" SelectedItem="{Binding ComparisonMode}" ToolTip="分析对照方式" Style="{StaticResource FilterComboInput}"/></StackPanel>
                                <StackPanel Margin="0,0,0,6"><TextBlock Text="执行" Style="{StaticResource FilterLabel}"/><Button Content="应用筛选" Command="{Binding RefreshCommand}" Style="{StaticResource FilterPrimaryButton}"/></StackPanel>
                            </WrapPanel>
                            <WrapPanel><StackPanel Width="170" Margin="0,0,8,6"><TextBlock Text="筛选方案名称" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding FilterName}" ToolTip="给当前筛选方案命名" Style="{StaticResource FilterTextInput}"/></StackPanel><StackPanel Margin="0,0,8,6"><TextBlock Text="保存" Style="{StaticResource FilterLabel}"/><Button Content="保存筛选" Command="{Binding SaveFilterCommand}" Style="{StaticResource FilterButton}"/></StackPanel><ItemsControl ItemsSource="{Binding SavedFilters}" VerticalAlignment="Bottom"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" ToolTip="{Binding Scope}" Command="{Binding ApplyCommand}" Margin="0,3,5,6" Padding="7,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></WrapPanel>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{Binding EditorSaveStatus}"
                                       Style="{StaticResource MutedTextStyle}"
                                       AutomationProperties.Name="编辑保存状态"
                                       AutomationProperties.LiveSetting="Polite" />
                            <WrapPanel Visibility="{Binding HasEditorSaveIssue, Converter={StaticResource BoolToVisibility}}"
                                       Margin="0,4,0,0">
                                <Button Content="保留本地副本"
                                        Command="{Binding KeepLocalDraftCommand}"
                                        ToolTip="保留当前输入，继续编辑或稍后重试保存"
                                        Margin="0,0,6,0" />
                                <Button Content="放弃本地并重载"
                                        Command="{Binding DiscardAndReloadEditorCommand}"
                                        ToolTip="明确放弃当前本地副本，并读取已持久化版本" />
                                <TextBlock Text="保留副本后可继续编辑并人工合并；退出失败时会提供 JSON 恢复文件。"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="8,3,0,0" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Metrics}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,8,8" Padding="11" MinHeight="82">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource MutedTextStyle}" FontSize="10" />
                                        <TextBlock Text="{Binding Value}" Foreground="{Binding ValueColor}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,2" />
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedTextStyle}" FontSize="9" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="最近 7 个交易日的累计利润与峰值回吐" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="每天一个点；柱高按这 7 天的累计利润区间缩放。" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                                <ItemsControl ItemsSource="{Binding Curve}" Height="125" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding OpenCommand}" Padding="0" Margin="0,0,5,0" BorderThickness="0" Background="Transparent" ToolTip="{Binding ToolTipText}">
                                                <StackPanel VerticalAlignment="Bottom" Width="58"><TextBlock Text="{Binding ValueText}" Foreground="{Binding ValueColor}" FontSize="9" HorizontalAlignment="Center"/><Border Height="{Binding Height}" Width="20" Background="{Binding ValueColor}" CornerRadius="3,3,0,0" HorizontalAlignment="Center"/><TextBlock Text="{Binding Date}" FontSize="8" Foreground="#718091" HorizontalAlignment="Center"/><TextBlock Text="{Binding DrawdownText}" FontSize="8" Foreground="#8491A0" HorizontalAlignment="Center"/></StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="数据质量" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding QualitySummary}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,8" />
                                <ItemsControl ItemsSource="{Binding Quality}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Button Command="{Binding OpenCommand}" ToolTip="{Binding Detail}" Padding="3" Margin="0,1" HorizontalContentAlignment="Stretch">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="65"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}"/><TextBlock Grid.Column="1" Text="{Binding Fraction}" Foreground="#AAB4C0"/><TextBlock Grid.Column="2" Text="{Binding PercentageText}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding StorageStatus}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,2" />
                                <WrapPanel>
                                    <Button Content="清理当前账户行情缓存" Command="{Binding ClearMarketDataCacheCommand}" Padding="7,3" Margin="0,3,8,3" />
                                    <TextBlock Text="{Binding CacheStatus}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,8,8"><StackPanel><TextBlock Text="原始费用拆分" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="仅汇总当前筛选 position 的成交；未映射费用保持账户级。" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,6"/><ItemsControl ItemsSource="{Binding FeeBreakdown}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="85"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}"/><TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource AccentBrush}"/><TextBlock Grid.Column="2" Text="{Binding Hint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="最近 7 个有成交日的现金盈亏" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="按成交发生服务器日；点击柱形查看对应 position。" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,6"/><ItemsControl ItemsSource="{Binding DailyCashSeries}" Height="118"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding OpenCommand}" Margin="0,0,5,0" Padding="4" VerticalAlignment="Bottom"><StackPanel VerticalAlignment="Bottom" Width="42"><TextBlock Text="{Binding CashPnlText}" Foreground="{Binding ValueColor}" FontSize="9" HorizontalAlignment="Center"/><Border Height="{Binding Height}" Width="20" Background="{Binding ValueColor}" CornerRadius="3,3,0,0" HorizontalAlignment="Center"/><TextBlock Text="{Binding Date}" FontSize="8" HorizontalAlignment="Center"/><TextBlock Text="{Binding DealCount, StringFormat={}{0} 成交}" FontSize="8" HorizontalAlignment="Center"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="日历与日记">
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource PageCardStyle}" Padding="10" Margin="0,0,8,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Calendar}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Command="{Binding OpenCommand}" Margin="3" Padding="8" HorizontalContentAlignment="Stretch">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Date}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CashPnl}" Foreground="{StaticResource AccentBrush}" FontSize="15" />
                                        <TextBlock Text="{Binding Closed, StringFormat=完整交易 {0}}" FontSize="9" Foreground="#8491A0" />
                                        <TextBlock Text="{Binding Pending, StringFormat=待复盘 {0}}" FontSize="9" Foreground="#8491A0" />
                                        <TextBlock Text="{Binding Journal}" FontSize="9" />
                                        <TextBlock Text="{Binding Gap}" FontSize="9" Foreground="#F0B35A" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PageCardStyle}" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <Grid><TextBlock Text="交易日日记" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding DailyStatus}" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/></Grid>
                        <TextBlock Text="日期" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding DailyDate}" Style="{StaticResource CompactInput}" IsReadOnly="True" ToolTip="从左侧日历选择日期，避免编辑身份与保存目标不一致"/>
                        <TextBlock Text="每日事实（点击日历日期刷新）" Style="{StaticResource SectionTitleStyle}" Margin="0,10,0,4"/>
                        <ItemsControl ItemsSource="{Binding DailyFacts}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Expander Header="{Binding Title}" Margin="0,2"><Border BorderBrush="#253244" BorderThickness="1" CornerRadius="5" Padding="8"><StackPanel><TextBlock Text="{Binding Value}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Border></Expander>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="当日过程" Style="{StaticResource SectionTitleStyle}" Margin="0,10,0,4"/>
                        <ListView ItemsSource="{Binding DailyTimeline}" MaxHeight="185"><ListView.View><GridView><GridViewColumn Header="时间" Width="65" DisplayMemberBinding="{Binding Time}"/><GridViewColumn Header="事件" Width="85" DisplayMemberBinding="{Binding Kind}"/><GridViewColumn Header="事实" Width="280" DisplayMemberBinding="{Binding Summary}"/><GridViewColumn Header="来源" Width="100" DisplayMemberBinding="{Binding Source}"/><GridViewColumn Header="交易" Width="75" DisplayMemberBinding="{Binding LinkedTrades}"/></GridView></ListView.View></ListView>
                        <TextBlock Text="盘前计划" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding PreMarketPlan}" AcceptsReturn="True" Height="75" TextWrapping="Wrap"/>
                        <TextBlock Text="盘中笔记" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding IntradayNotes}" AcceptsReturn="True" Height="75" TextWrapping="Wrap"/>
                        <TextBlock Text="盘后总结" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding PostMarketSummary}" AcceptsReturn="True" Height="75" TextWrapping="Wrap"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,5,0"><TextBlock Text="做得好" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding DailyDidWell}" AcceptsReturn="True" Height="52" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="需要改进" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding DailyToImprove}" AcceptsReturn="True" Height="52" TextWrapping="Wrap"/></StackPanel></Grid>
                        <TextBlock Text="下一次动作" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding DailyNextAction}" AcceptsReturn="True" Height="58" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,10,0,0"><Button Content="保存草稿" Command="{Binding SaveDailyJournalCommand}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="完成日总结" Command="{Binding CompleteDailyJournalCommand}" Margin="7,0,0,0" ToolTip="冻结当前成交/费用源版本；后续数据补齐会标记需重审"/></WrapPanel>
                    </StackPanel></ScrollViewer>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="交易档案">
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource PageCardStyle}" Padding="6" Margin="0,0,8,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6">
                            <Button Content="上一页" Command="{Binding PreviousPageCommand}"/><TextBlock Text="{Binding PageText}" Margin="10,5"/><Button Content="下一页" Command="{Binding NextPageCommand}"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="#253244" BorderThickness="0,0,0,1" Padding="3,2,3,7" Margin="0,0,0,6"><StackPanel>
                            <WrapPanel><Button Content="选择/取消本页" Command="{Binding SelectPageCommand}" Padding="7,3"/><TextBlock Text="{Binding BulkSelectionText}" Margin="8,5" Style="{StaticResource MutedTextStyle}"/></WrapPanel>
                            <WrapPanel><TextBox Width="105" Text="{Binding BulkStrategy}" ToolTip="批量策略" Style="{StaticResource CompactInput}"/><Button Content="设策略" Command="{Binding BulkStrategyCommand}" Margin="0,3,8,6"/><TextBox Width="120" Text="{Binding BulkTags}" ToolTip="替换全部标签" Style="{StaticResource CompactInput}"/><Button Content="替换标签" Command="{Binding BulkTagsCommand}" Margin="0,3,8,6"/></WrapPanel>
                            <WrapPanel><ComboBox Width="95" ItemsSource="{Binding BulkStatusOptions}" SelectedItem="{Binding BulkStatus}" Margin="0,3,8,6"/><Button Content="改复盘状态" Command="{Binding BulkStatusCommand}" Margin="0,3,8,6"/></WrapPanel>
                        </StackPanel></Border>
                        <ListView ItemsSource="{Binding Trades}" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                            <ListView.ItemTemplate><DataTemplate>
                                <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="加入批量操作"/>
                                    <Button Grid.Column="1" Command="{Binding OpenCommand}" HorizontalContentAlignment="Stretch" Padding="8">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="65"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="{Binding Symbol}" FontWeight="SemiBold"/><TextBlock Text="{Binding ClosedAt}" FontSize="9" Foreground="#8491A0"/><TextBlock Text="{Binding Strategy}" FontSize="9"/></StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding NetPnl}" Foreground="{Binding PnlColor}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PageCardStyle}" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <Grid><TextBlock Text="{Binding SelectedTradeTitle}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding DocumentStatus}" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/></Grid>
                        <TextBlock Text="{Binding TradeIdentity}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding TradeFacts}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <TextBlock Text="原始成交明细（只读）" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,4"/>
                        <ListView ItemsSource="{Binding TradeDeals}" MaxHeight="145"><ListView.View><GridView>
                            <GridViewColumn Header="时间" Width="100" DisplayMemberBinding="{Binding Time}"/><GridViewColumn Header="ticket" Width="85" DisplayMemberBinding="{Binding Ticket}"/><GridViewColumn Header="类型" Width="75" DisplayMemberBinding="{Binding Kind}"/><GridViewColumn Header="数量" Width="60" DisplayMemberBinding="{Binding Volume}"/><GridViewColumn Header="价格" Width="75" DisplayMemberBinding="{Binding Price}"/><GridViewColumn Header="利润" Width="65" DisplayMemberBinding="{Binding Profit}"/><GridViewColumn Header="佣金" Width="60" DisplayMemberBinding="{Binding Commission}"/><GridViewColumn Header="隔夜" Width="55" DisplayMemberBinding="{Binding Swap}"/><GridViewColumn Header="其他费" Width="55" DisplayMemberBinding="{Binding Fee}"/><GridViewColumn Header="净额" Width="65" DisplayMemberBinding="{Binding NetPnl}"/>
                        </GridView></ListView.View></ListView>
                        <TextBlock Text="计划与风险来源" Style="{StaticResource SectionTitleStyle}" Margin="0,12,0,4"/>
                        <TextBlock Text="{Binding PlanFacts}" TextWrapping="Wrap"/><TextBlock Text="{Binding RiskFacts}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock Text="交易总结（完成复盘必填）" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged, Delay=250}" AcceptsReturn="True" Height="66" TextWrapping="Wrap"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,5,0"><TextBlock Text="入场理由" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding EntryReason, UpdateSourceTrigger=PropertyChanged, Delay=250}" AcceptsReturn="True" Height="58" TextWrapping="Wrap"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="退出理由" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding ExitReason, UpdateSourceTrigger=PropertyChanged, Delay=250}" AcceptsReturn="True" Height="58" TextWrapping="Wrap"/></StackPanel>
                        </Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,5,0"><TextBlock Text="做得好" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding DidWell, UpdateSourceTrigger=PropertyChanged, Delay=250}" AcceptsReturn="True" Height="55" TextWrapping="Wrap"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="需要改进" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding ToImprove, UpdateSourceTrigger=PropertyChanged, Delay=250}" AcceptsReturn="True" Height="55" TextWrapping="Wrap"/></StackPanel>
                        </Grid>
                        <TextBlock Text="下一次执行动作（完成复盘必填）" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding NextAction, UpdateSourceTrigger=PropertyChanged, Delay=250}" AcceptsReturn="True" Height="55" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,7,0,0"><TextBox Width="130" Text="{Binding Emotion, UpdateSourceTrigger=PropertyChanged}" ToolTip="自报情绪" Style="{StaticResource CompactInput}"/><TextBox Width="180" Text="{Binding MarketCondition, UpdateSourceTrigger=PropertyChanged}" ToolTip="市场环境" Style="{StaticResource CompactInput}"/></WrapPanel>
                        <WrapPanel><Button Content="保存草稿" Command="{Binding SaveReviewCommand}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="标记已复盘" Command="{Binding MarkReviewedCommand}" Margin="7,0,0,0"/></WrapPanel>
                        <TextBlock Text="执行评价" Style="{StaticResource SectionTitleStyle}" Margin="0,14,0,5"/>
                        <ItemsControl ItemsSource="{Binding RuleAssessments}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition/><ColumnDefinition Width="115"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Section}"/><TextBlock Grid.Column="1" Text="{Binding Name}"/><ComboBox Grid.Column="2" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}"/><TextBox Grid.Column="3" Text="{Binding Notes}" ToolTip="证据或说明"/>
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Button Content="保存执行评价" Command="{Binding SaveAssessmentsCommand}" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                        <TextBlock Text="交易过程与行为证据" Style="{StaticResource SectionTitleStyle}" Margin="0,14,0,5"/>
