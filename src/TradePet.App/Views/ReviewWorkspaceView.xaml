                        <WrapPanel><TextBox Width="130" Text="{Binding GoalSymbols}" ToolTip="适用品种，逗号分隔；留空表示全部" Style="{StaticResource CompactInput}"/><TextBox Width="105" Text="{Binding GoalObservationWindow}" ToolTip="观察窗口（天）" Style="{StaticResource CompactInput}"/></WrapPanel>
                        <TextBox Text="{Binding GoalEndCondition}" ToolTip="结束条件" Style="{StaticResource CompactInput}"/><CheckBox Content="启用桌宠提醒（仅自动规则目标可用）" IsChecked="{Binding GoalNotificationEnabled}" Margin="0,5"/><Button Content="保存新目标 / 新版本" Command="{Binding SaveGoalCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,5,0,8"/>
                        <ItemsControl ItemsSource="{Binding Goals}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#253244" BorderThickness="0,0,0,1" Padding="0,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><WrapPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text=" · "/><TextBlock Text="{Binding Status}" Foreground="#8491A0"/></WrapPanel><TextBlock Text="{Binding Measurement}" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding Target, StringFormat=目标：{0}}"/><TextBlock Text="{Binding ObservationSummary}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="查看/升级" Command="{Binding OpenCommand}" Margin="8,0,0,0" VerticalAlignment="Top" Padding="7,2"/><Button Grid.Column="2" Content="归档" Command="{Binding ArchiveCommand}" IsEnabled="{Binding CanArchive}" Margin="5,0,0,0" VerticalAlignment="Top" Padding="7,2"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel></Border>
                </StackPanel>
            </Grid></ScrollViewer>
        </TabItem>

        <TabItem Header="机会记录">
            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource PageCardStyle}" Padding="14" Margin="0,0,8,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <Grid><TextBlock Text="记录未成交机会或合理放弃" Style="{StaticResource SectionTitleStyle}"/><Button Content="新建记录" Command="{Binding NewOpportunityCommand}" HorizontalAlignment="Right"/></Grid>
                    <ComboBox ItemsSource="{Binding OpportunityKindOptions}" SelectedItem="{Binding OpportunityKind}" Margin="0,8,0,5"/>
                    <WrapPanel><TextBox Width="120" Text="{Binding OpportunitySymbol}" ToolTip="精确品种" Style="{StaticResource CompactInput}"/><ComboBox Width="85" ItemsSource="{Binding OpportunitySideOptions}" SelectedItem="{Binding OpportunitySide}" Margin="0,3,8,6"/></WrapPanel>
                    <TextBox Text="{Binding OpportunityPlaybook}" ToolTip="策略版本 ID，可留空" Style="{StaticResource CompactInput}"/>
                    <WrapPanel><TextBox Width="90" Text="{Binding OpportunityEntry}" ToolTip="参考入场" Style="{StaticResource CompactInput}"/><TextBox Width="90" Text="{Binding OpportunityStop}" ToolTip="参考止损" Style="{StaticResource CompactInput}"/><TextBox Width="90" Text="{Binding OpportunityTarget}" ToolTip="参考目标" Style="{StaticResource CompactInput}"/></WrapPanel>
                    <TextBlock Text="预设条件" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding OpportunityConditions}" ToolTip="当时预先观察的条件" AcceptsReturn="True" Height="55" TextWrapping="Wrap"/>
                    <TextBlock Text="未参与原因" Style="{StaticResource EditorLabel}"/><ComboBox ItemsSource="{Binding OpportunityReasonOptions}" Text="{Binding OpportunityReason, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"/>
                    <TextBox Text="{Binding OpportunityLinkedTrade}" ToolTip="后续关联 position ID，可留空" Style="{StaticResource CompactInput}" Margin="0,7,0,0"/>
                    <TextBox Text="{Binding OpportunityNotes}" ToolTip="观察与后续复盘" AcceptsReturn="True" Height="85" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,8,0,0"><Button Content="保存机会记录" Command="{Binding SaveOpportunityCommand}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="导入机会截图" Command="{Binding ImportOpportunityAttachmentCommand}" Margin="7,0,0,0"/></WrapPanel>
                    <TextBlock Text="已选记录的证据" Style="{StaticResource EditorLabel}" Margin="0,8,0,0"/>
                    <ListBox ItemsSource="{Binding OpportunityAttachments}" MaxHeight="150" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Source="{Binding Thumbnail}" Width="50" Height="38" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{Binding FileName}" ToolTip="{Binding Source}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="2" Content="打开" Command="{Binding OpenCommand}" Padding="6,2"/><Button Grid.Column="3" Content="删除" Command="{Binding DeleteCommand}" Padding="6,2" Margin="4,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <Separator Margin="0,14"/>
                    <TextBlock Text="公开分享导出范围" Style="{StaticResource EditorLabel}"/>
                    <ComboBox ItemsSource="{Binding ExportScopeOptions}" SelectedItem="{Binding ExportScope}" Margin="0,4,0,5"/>
                    <Button Content="生成公开导出预览" Command="{Binding ExportCommand}"/>
                    <TextBlock Text="{Binding ExportPreview}" TextWrapping="Wrap" Margin="0,7,0,5"/>
                    <TextBlock Text="原始截图/附件默认不包含；仅勾选确实要公开的文件。图片内容无法自动保证匿名。"
                               Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding ExportAttachmentOptions}" MaxHeight="130" Margin="0,4,0,6">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Margin="0,3,0,3">
                                <CheckBox IsChecked="{Binding IsIncluded}" Content="{Binding Display}" ToolTip="勾选后原始文件将进入公开分享包；请自行检查画面与文件内容"/>
                                <TextBox Text="{Binding PublicNote, UpdateSourceTrigger=PropertyChanged}" ToolTip="公开说明；原文件名不会进入分享包，已识别的账户和本机路径会被遮盖" Style="{StaticResource CompactInput}"/>
                            </StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="确认并写出公开分享 ZIP" Command="{Binding ConfirmExportCommand}" IsEnabled="{Binding CanConfirmExport}"/>
                    <Button Content="创建完整本地备份" Command="{Binding BackupCommand}" Margin="0,7,0,0"/>
                    <Button Content="校验并恢复本地备份" Command="{Binding RestoreCommand}" Margin="0,7,0,0"/>
                    <TextBlock Text="{Binding ExportStatus}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel></ScrollViewer></Border>
                <Border Grid.Column="1" Style="{StaticResource PageCardStyle}" Padding="8"><ListView ItemsSource="{Binding Opportunities}"><ListView.View><GridView><GridViewColumn Header="日期" Width="70" DisplayMemberBinding="{Binding Date}"/><GridViewColumn Header="品种" Width="85" DisplayMemberBinding="{Binding Symbol}"/><GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding Kind}"/><GridViewColumn Header="原因" Width="135" DisplayMemberBinding="{Binding Reason}"/><GridViewColumn Header="记录" Width="190" DisplayMemberBinding="{Binding Notes}"/><GridViewColumn Header="操作" Width="65"><GridViewColumn.CellTemplate><DataTemplate><Button Content="编辑" Command="{Binding OpenCommand}" Padding="7,3" Margin="0"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn></GridView></ListView.View></ListView></Border>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
