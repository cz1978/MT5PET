Binding="{Binding MfeText}"/><GridViewColumn Header="实际 R" Width="65" DisplayMemberBinding="{Binding ActualRText}"/><GridViewColumn Header="覆盖" Width="65" DisplayMemberBinding="{Binding Coverage}"/><GridViewColumn Header="下钻" Width="55"><GridViewColumn.CellTemplate><DataTemplate><Button Content="查看" Command="{Binding OpenCommand}" Padding="6,2"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn></GridView></ListView.View></ListView></StackPanel>
