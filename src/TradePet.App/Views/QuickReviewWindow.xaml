<Window x:Class="TradePet.App.Views.QuickReviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="平仓后快速复盘" Width="480" Height="660" MinWidth="420" MinHeight="460" WindowStartupLocation="CenterScreen" Topmost="False" ShowActivated="False" ResizeMode="CanResize" Background="#121923">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="平仓后快速复盘" Foreground="#F2F5F4" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="TradeText" Foreground="#AAB7C4" Margin="0,4,0,12"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="是否按计划" Foreground="#EEF3F1"/><ComboBox x:Name="PlanBox" SelectedIndex="2" Margin="0,4,0,9"><ComboBoxItem Content="是"/><ComboBoxItem Content="否"/><ComboBoxItem Content="不确定"/></ComboBox>
            <TextBlock Text="平仓原因（自动推测，可修改）" Foreground="#EEF3F1"/>
            <WrapPanel Margin="0,5,0,2">
                <WrapPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Margin" Value="0,0,6,6"/>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                </WrapPanel.Resources>
                <Button Content="触发止盈" Tag="触发预设止盈价，自动平仓" ToolTip="终端在预设止盈价触发平仓" Click="ReasonPreset_Click"/>
                <Button Content="触发止损" Tag="触发预设止损价，自动平仓" ToolTip="包括移动止损、保本止损；触发止损不一定亏损" Click="ReasonPreset_Click"/>
                <Button Content="手动止盈" Tag="主动平仓，兑现盈利" ToolTip="有盈利时主动结束持仓" Click="ReasonPreset_Click"/>
                <Button Content="手动止损" Tag="主动平仓，接受当前亏损" ToolTip="有亏损时主动结束持仓" Click="ReasonPreset_Click"/>
                <Button Content="手动保本" Tag="接近保本时主动平仓" ToolTip="接近保本时主动结束持仓，可能仍有手续费" Click="ReasonPreset_Click"/>
            </WrapPanel>
            <TextBlock Text="选择实际平仓方式；具体原因或其他情况可在下方补充。" Foreground="#AAB7C4" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5"/>
            <TextBox x:Name="ExitReasonBox" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,3"/>
            <TextBlock Text="自动复盘依据" Foreground="#EEF3F1" Margin="0,6,0,4"/>
            <TextBlock x:Name="AnalysisText" Foreground="#7FB7A9" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,9"/>
            <TextBlock Text="改进事项（已自动生成，可修改）" Foreground="#EEF3F1"/><TextBox x:Name="ImproveBox" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="跳过" Click="Skip_Click" Padding="10,5"/><Button Content="稍后" Click="Later_Click" Padding="10,5" Margin="8,0"/><Button Content="保存到交易档案" Click="Save_Click" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>
