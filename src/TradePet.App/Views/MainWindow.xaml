<Window x:Class="TradePet.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TradePet.App.Controls"
        xmlns:views="clr-namespace:TradePet.App.Views"
        Title="天禄交易助手" Icon="/TradePet;component/Assets/tradepet-icon.ico"
        Width="1040" Height="696" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <DataTemplate x:Key="ReviewCategoryPanelTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ListBox ItemsSource="{Binding ReviewCategories}"
                         SelectedItem="{Binding SelectedReviewCategory, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource ReviewCategoryTabStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="25" Height="25" CornerRadius="7" Background="#20342F"
                                        BorderBrush="#31574D" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" Foreground="{StaticResource AccentBrush}"
                                               FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="7,0,0,0"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="#718091"
                                           FontSize="9" VerticalAlignment="Center" Margin="5,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="1" Background="#0F1620" BorderBrush="#202B3A" BorderThickness="1"
                        CornerRadius="10" Padding="12" Margin="0,1,7,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedReviewCategory.Icon}" Foreground="{StaticResource AccentBrush}"
                                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedReviewCategory.Label, StringFormat={}{0}表现}"
                                           FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedReviewCategory.Hint}" Style="{StaticResource MutedTextStyle}"
                                       FontSize="10" Margin="0,4,10,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="1" BorderBrush="#263142" BorderThickness="1,0,0,0" Padding="13,0,8,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="最佳净盈亏" Style="{StaticResource MutedTextStyle}" FontSize="9" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SelectedReviewCategory.BestGroup}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                    <TextBlock Text="{Binding SelectedReviewCategory.BestNetPnl}"
                                               Foreground="{Binding SelectedReviewCategory.BestNetPnlColor}"
                                               FontWeight="SemiBold" Margin="7,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="#263142" BorderThickness="1,0,0,0" Padding="13,0,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="交易最多" Style="{StaticResource MutedTextStyle}" FontSize="9" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SelectedReviewCategory.MostActiveGroup}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                    <TextBlock Text="{Binding SelectedReviewCategory.MostActiveTrades}" Foreground="#AAB7C4"
                                               FontSize="10" Margin="7,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="#0C121B" BorderBrush="#202B3A" BorderThickness="1"
                        CornerRadius="10" Margin="0,0,7,0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Background="#101823" Height="37">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="分组" Style="{StaticResource MutedTextStyle}" Margin="12,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="交易数" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="胜率" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="净盈亏" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="盈亏因子" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="期望值" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{Binding VisibleReviewGroups}"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  Visibility="{Binding SelectedReviewCategory.HasGroups, Converter={StaticResource BoolToVisibility}}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#182230" BorderThickness="0,0,0,1" Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Group}" Margin="12,0" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Group}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Trades}" />
                                            <TextBlock Grid.Column="2" Text="{Binding WinRate}" />
                                            <TextBlock Grid.Column="3" Text="{Binding NetPnl}" Foreground="{Binding NetPnlColor}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="4" Text="{Binding ProfitFactor}" />
                                            <TextBlock Grid.Column="5" Text="{Binding Expectancy}" Foreground="{Binding ExpectancyColor}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Grid.Row="1" Text="这个分类还没有可用数据。"
                                   Style="{StaticResource MutedTextStyle}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding SelectedReviewCategory.HasNoGroups, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="186" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="#202A38" BorderThickness="0,0,1,0">
            <Grid Margin="15,18,15,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="142" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="9" Background="#19241F"
                                BorderBrush="#3B4A3F" BorderThickness="1">
                            <TextBlock Text="禄" Foreground="{StaticResource GoldBrush}" FontSize="17"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="天禄" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="交易守护助手" Style="{StaticResource MutedTextStyle}" FontSize="10" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <controls:PetSpriteControl Grid.Row="1" Width="118" Height="128"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Activity="{Binding PetActivity}"
                                           AtlasPath="Assets/baoer-pet/spritesheet.webp"
                                           PlaybackRate="0.65" />

                <ListBox x:Name="NavigationList" Grid.Row="2"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SideNavItemStyle}"
                         SelectedIndex="{Binding ElementName=MainTabs, Path=SelectedIndex, Mode=TwoWay}">
                    <ListBoxItem Content="今日概览" />
                    <ListBoxItem Content="交易计划" />
                    <ListBoxItem Content="亏损区域" />
                    <ListBoxItem Content="复盘分析" />
                    <ListBoxItem Content="时间线" />
                    <ListBoxItem Content="设置中心" />
                </ListBox>

                <Border Grid.Row="3" Style="{StaticResource PageCardStyle}" Padding="12" Background="#101821">
                    <StackPanel>
                        <TextBlock Text="连接状态" FontWeight="SemiBold" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource MutedTextStyle}"
                                       TextTrimming="CharacterEllipsis" Width="126" />
                        </StackPanel>
                        <TextBlock Text="{Binding BridgeText}" Style="{StaticResource MutedTextStyle}"
                                   Margin="14,4,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding AccountLabel}" Foreground="#C7D1CD" FontSize="11"
                                   Margin="0,9,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource PanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="84" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Grid Margin="22,16,22,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding GreetingText}" FontSize="22" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="守住计划，尊重市场，等待属于你的机会" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="  ·  服务器交易日 " Foreground="#546170" FontSize="11" />
                        <TextBlock Text="{Binding ServerDateText}" Foreground="#AEBBB5" FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="专注模式" Command="{Binding ToggleFocusCommand}" Style="{StaticResource QuietButtonStyle}" />
                    <Button Content="收起控制台" Click="HideWindow_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0" />
                </StackPanel>
            </Grid>

            <TabControl x:Name="MainTabs" Grid.Row="1" Margin="22,0,22,10"
                        Background="Transparent" BorderThickness="0" SelectedIndex="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </TabControl.Template>

                <TabItem Header="今日概览">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <UniformGrid Columns="4" Margin="0,0,0,12">
                                <Border Style="{StaticResource MetricCardStyle}" Background="{Binding TotalPnlBackground}">
                                    <StackPanel>
                                        <TextBlock Text="今日合计" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Text="{Binding TotalPnl, StringFormat={}{0:+0.##;-0.##;0}}"
                                                   Foreground="{Binding TotalPnlColor}" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <TextBlock Text="含浮动盈亏" Foreground="#608E81" FontSize="10" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="已实现盈亏" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Text="{Binding RealizedPnl, StringFormat={}{0:+0.##;-0.##;0}}"
                                                   Foreground="{Binding RealizedPnlColor}" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <TextBlock Text="已平仓交易" Foreground="#65719C" FontSize="10" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="交易次数" Style="{StaticResource MutedTextStyle}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding TradeCount}" Foreground="{StaticResource GoldBrush}"
                                                       FontSize="25" FontWeight="SemiBold" />
                                            <TextBlock Text=" 次" Foreground="#8B826C" FontSize="11" VerticalAlignment="Bottom" Margin="2,0,0,4" />
                                        </StackPanel>
                                        <TextBlock Text="完整交易" Foreground="#8B826C" FontSize="10" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PageCardStyle}" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="今日连亏" Style="{StaticResource MutedTextStyle}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding ConsecutiveLosses}" Foreground="{Binding ConsecutiveLossesColor}"
                                                       FontSize="25" FontWeight="SemiBold" />
                                            <TextBlock Text=" 次" Foreground="#987272" FontSize="11" VerticalAlignment="Bottom" Margin="2,0,0,4" />
                                        </StackPanel>
                                        <TextBlock Text="保持交易节奏" Foreground="#987272" FontSize="10" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.65*" />
                                    <ColumnDefinition Width="0.95*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource PageCardStyle}" Margin="0,0,10,0" MinHeight="195">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="当前持仓" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="实时同步，只读显示" Style="{StaticResource MutedTextStyle}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,15,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.3*" /><ColumnDefinition /><ColumnDefinition />
                                                <ColumnDefinition /><ColumnDefinition Width="1.1*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="品种" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Grid.Column="1" Text="方向" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Grid.Column="2" Text="手数" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Grid.Column="3" Text="浮动盈亏" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Grid.Column="4" Text="持仓时长" Style="{StaticResource MutedTextStyle}" />
                                        </Grid>
                                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Positions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0F1620" BorderBrush="#202A38" BorderThickness="0,1,0,0" Padding="0,11">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.3*" /><ColumnDefinition /><ColumnDefinition />
                                                                <ColumnDefinition /><ColumnDefinition Width="1.1*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Side}" Foreground="{StaticResource AccentBrush}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Volume}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Profit}" Foreground="{Binding ProfitColor}" />
                                                            <TextBlock Grid.Column="4" Text="{Binding Duration}" Foreground="{StaticResource MutedBrush}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding HasNoPositions, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="当前没有持仓" Foreground="#718078" FontSize="13" HorizontalAlignment="Center" />
                                            <TextBlock Text="开仓后会在这里实时显示，只读同步。" Style="{StaticResource MutedTextStyle}"
                                                       FontSize="10" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource PageCardStyle}" MinHeight="195">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="当前风险" Style="{StaticResource SectionTitleStyle}" />
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border Width="92" Height="92" CornerRadius="46" BorderBrush="#295D54" BorderThickness="9"
                                                    Background="#0E171A">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="风险" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding RiskText}" Foreground="{StaticResource AccentBrush}" FontSize="13"
                                                               FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"
                                                               TextWrapping="Wrap" MaxWidth="70" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="盈利次数" Style="{StaticResource MutedTextStyle}" />
                                                <TextBlock Text="{Binding WinCount}" Foreground="{Binding WinCountColor}" FontSize="17" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="亏损次数" Style="{StaticResource MutedTextStyle}" />
                                                <TextBlock Text="{Binding LossCount}" Foreground="{Binding LossCountColor}" FontSize="17" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource PageCardStyle}" Padding="15">
                                <UniformGrid Columns="4">
                                    <StackPanel>
                                        <TextBlock Text="今日最高盈亏" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Text="{Binding HighWaterPnl, StringFormat={}{0:+0.##;-0.##;0}}" Foreground="{Binding HighWaterPnlColor}" FontSize="17" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="当前浮动盈亏" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Text="{Binding FloatingPnl, StringFormat={}{0:+0.##;-0.##;0}}" Foreground="{Binding FloatingPnlColor}" FontSize="17" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="当前盈利回吐" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Text="{Binding Giveback, StringFormat={}{0:0.##}}" Foreground="{Binding GivebackColor}" FontSize="17" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="最大总仓位" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Text="{Binding MaximumExposure, StringFormat={}{0:0.##} 手}" FontSize="17" Margin="0,5,0,0" />
                                    </StackPanel>
                                </UniformGrid>
                            </Border>

                            <Grid Margin="0,12,0,0" Height="118">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource PageCardStyle}" Margin="0,0,10,0" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <TextBlock Text="今日计划" Style="{StaticResource SectionTitleStyle}" FontSize="14" />
                                        <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="盈利目标" Style="{StaticResource MutedTextStyle}" FontSize="10" />
                                                <TextBlock Text="{Binding DailyTarget, TargetNullValue=未设置}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="亏损上限" Style="{StaticResource MutedTextStyle}" FontSize="10" />
                                                <TextBlock Text="{Binding DailyLoss, TargetNullValue=未设置}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="最多交易" Style="{StaticResource MutedTextStyle}" FontSize="10" />
                                                <TextBlock Text="{Binding MaximumTrades, TargetNullValue=未设置}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="最大手数" Style="{StaticResource MutedTextStyle}" FontSize="10" />
                                                <TextBlock Text="{Binding MaximumLot, TargetNullValue=未设置}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource PageCardStyle}" Margin="0,0,10,0" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="行为管理" Style="{StaticResource SectionTitleStyle}" FontSize="14" />
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                            <TextBlock Text="当前状态" Style="{StaticResource MutedTextStyle}" FontSize="10" />
                                            <TextBlock Text="{Binding TodayBehaviorRiskText}" Foreground="{StaticResource AccentBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding BehaviorPresetText, StringFormat=预设：{0}}" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding TodayBehaviorTriggeredText}" Foreground="#C1CEC8" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Text="打开复盘分析管理规则" Style="{StaticResource MutedTextStyle}" FontSize="10" />
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource PageCardStyle}" Margin="0,0,10,0" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="亏损预警" Style="{StaticResource SectionTitleStyle}" FontSize="14" />
                                            <TextBlock Text="按最近触发排序" Style="{StaticResource MutedTextStyle}" FontSize="10"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <ScrollViewer Grid.Row="1" Margin="0,9,0,0" VerticalScrollBarVisibility="Hidden">
                                            <ItemsControl ItemsSource="{Binding LossZones}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#171923" BorderBrush="#4A2D35" BorderThickness="1"
                                                                CornerRadius="7" Padding="8,6" Margin="0,0,0,5">
                                                            <Grid>
                                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                                <TextBlock Text="{Binding Symbol}" FontSize="11" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Loss}" Foreground="{Binding LossColor}" FontSize="10"
                                                                           HorizontalAlignment="Right" />
                                                                <TextBlock Grid.Row="1" Text="{Binding Range}" Foreground="#DFA1A8" FontSize="9" Margin="0,3,0,0" />
                                                                <TextBlock Grid.Row="1" Text="{Binding Attempts}" Foreground="#7F8C89" FontSize="8"
                                                                           HorizontalAlignment="Right" Margin="8,3,0,0" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="3" Style="{StaticResource PageCardStyle}" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="最近记录" Style="{StaticResource SectionTitleStyle}" FontSize="14" />
                                            <TextBlock Text="全部事实都可追溯" Style="{StaticResource MutedTextStyle}" FontSize="10"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <ScrollViewer Grid.Row="1" Margin="0,9,0,0" VerticalScrollBarVisibility="Hidden">
                                            <ItemsControl ItemsSource="{Binding Timeline}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Time}" Foreground="#65717F" FontSize="10" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="{StaticResource AccentBrush}" FontSize="10" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Summary}" Foreground="#AFB9B5" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="交易计划">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="交易计划" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="提前写下边界，交易时只负责执行。" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="{Binding PlanRecordingText}" Command="{Binding TogglePlanRecordingCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Content="从当前图表导入" Command="{Binding ImportPlanCommand}" Style="{StaticResource QuietButtonStyle}" Margin="0" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource PageCardStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="今日交易边界" Style="{StaticResource SectionTitleStyle}" />
                                    <Button Content="保存计划" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Right" Padding="13,7" Margin="0" />
                                </Grid>
                                <UniformGrid Grid.Row="1" Columns="5" Margin="0,15,0,0">
                                    <StackPanel Margin="0,0,9,0">
                                        <TextBlock Text="每日盈利目标" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding DailyTarget, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,9,0">
                                        <TextBlock Text="每日亏损上限" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding DailyLoss, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,9,0">
                                        <TextBlock Text="最多交易次数" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding MaximumTrades, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,9,0">
                                        <TextBlock Text="最大单笔手数" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding MaximumLot, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="亏损区半径（报价点）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding LossZoneTolerance, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                                    <CheckBox Content="持仓持续无止损时提醒" IsChecked="{Binding StopLossReminderEnabled}" VerticalAlignment="Center" />
                                    <TextBlock Text="等待" Style="{StaticResource MutedTextStyle}" Margin="16,0,6,0" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding StopLossReminderSeconds, UpdateSourceTrigger=LostFocus}" Width="72" />
                                    <TextBlock Text="秒（仅提醒，不会修改持仓）" Style="{StaticResource MutedTextStyle}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource PageCardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="116"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Margin="16,13">
                                    <TextBlock Text="图表计划对象" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="新增对象后选择用途；移动会同步，删除会保留历史。" Style="{StaticResource MutedTextStyle}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Border Grid.Row="1" Background="#111A24" BorderBrush="#202A38" BorderThickness="0,1,0,1" Padding="12,10">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="0.8*"/><ColumnDefinition/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="结构化计划（用于风险倍数和计划偏离统计）" Style="{StaticResource MutedTextStyle}" FontSize="11" Grid.ColumnSpan="6" />
                                        <StackPanel Grid.Row="1" Margin="0,7,7,0"><TextBlock Text="品种" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding NewPlanSymbol, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,7,7,0"><TextBlock Text="方向" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding TradeSideOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NewPlanSide}" /></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,7,7,0"><TextBlock Text="参考入场" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding NewPlanReferenceEntry, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,7,7,0"><TextBlock Text="入场区" Style="{StaticResource FieldLabelStyle}"/><StackPanel Orientation="Horizontal"><TextBox Width="58" Text="{Binding NewPlanEntryLow, UpdateSourceTrigger=LostFocus}"/><TextBlock Text=" – " VerticalAlignment="Center"/><TextBox Width="58" Text="{Binding NewPlanEntryHigh, UpdateSourceTrigger=LostFocus}"/></StackPanel></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,7,7,0"><TextBlock Text="止损 / 目标" Style="{StaticResource FieldLabelStyle}"/><StackPanel Orientation="Horizontal"><TextBox Width="58" Text="{Binding NewPlanStop, UpdateSourceTrigger=LostFocus}"/><TextBlock Text=" / " VerticalAlignment="Center"/><TextBox Width="58" Text="{Binding NewPlanTarget, UpdateSourceTrigger=LostFocus}"/></StackPanel></StackPanel>
                                        <Button Grid.Row="1" Grid.Column="5" Content="保存结构化计划" Command="{Binding CreateStructuredPlanCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" Margin="0,7,0,0" Padding="10,7" />
                                        <StackPanel Grid.Row="2" Margin="0,7,7,0"><TextBlock Text="策略" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding NewPlanStrategy, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,7,7,0"><TextBlock Text="形态" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding NewPlanSetup, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,7,7,0"><TextBlock Text="标签（逗号分隔）" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding NewPlanTags, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="5" Margin="0,7,0,0"><TextBlock Text="备注" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding NewPlanNotes, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                    </Grid>
                                </Border>
                                <ListView Grid.Row="2" ItemsSource="{Binding StructuredPlans}"
                                          MaxHeight="116"
                                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="计划品种" Width="95" DisplayMemberBinding="{Binding Symbol}" />
                                            <GridViewColumn Header="方向" Width="55" DisplayMemberBinding="{Binding Side}" />
                                            <GridViewColumn Header="入场区" Width="125" DisplayMemberBinding="{Binding EntryRange}" />
                                            <GridViewColumn Header="止损 / 目标" Width="150" DisplayMemberBinding="{Binding StopTarget}" />
                                            <GridViewColumn Header="策略 / 形态" Width="130" DisplayMemberBinding="{Binding Strategy}" />
                                            <GridViewColumn Header="计划风险倍数" Width="95" DisplayMemberBinding="{Binding RiskMultiple}" />
                                            <GridViewColumn Header="状态" Width="70" DisplayMemberBinding="{Binding Status}" />
                                            <GridViewColumn Header="操作" Width="145">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="修改" Command="{Binding ReviseCommand}"
                                                                    Style="{StaticResource QuietButtonStyle}" Padding="7,3" Margin="0,0,5,0" />
                                                            <Button Content="{Binding ToggleText}" Command="{Binding ToggleActiveCommand}"
                                                                    Style="{StaticResource QuietButtonStyle}" Padding="7,3" Margin="0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <ListView Grid.Row="3" ItemsSource="{Binding PlanItems}"
                                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="品种" Width="100" DisplayMemberBinding="{Binding Symbol}" />
                                            <GridViewColumn Header="对象范围" Width="190" DisplayMemberBinding="{Binding KindText}" />
                                            <GridViewColumn Header="图表文字" Width="150" DisplayMemberBinding="{Binding Text}" />
                                            <GridViewColumn Header="计划用途" Width="170">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox Width="155"
                                                                  ItemsSource="{Binding DataContext.PlanCategoryOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                  SelectedValue="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="状态" Width="78" DisplayMemberBinding="{Binding ActiveText}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="亏损区域">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="亏损区域" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="只由完整亏损交易生成，用来识别重复犯错的位置。" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemsSource="{Binding LossZones}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PageCardStyle}" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/><ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.4*"/><ColumnDefinition/><ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="品种" Style="{StaticResource MutedTextStyle}" />
                                                    <TextBlock Text="{Binding Symbol}" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="价格区间" Style="{StaticResource MutedTextStyle}" />
                                                    <TextBlock Text="{Binding Range}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                                    <TextBlock Text="{Binding Center}" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="尝试记录" Style="{StaticResource MutedTextStyle}" />
                                                    <TextBlock Text="{Binding Attempts}" Margin="0,8,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="累计亏损" Style="{StaticResource MutedTextStyle}" />
                                                    <TextBlock Text="{Binding Loss}" Foreground="{Binding LossColor}" Margin="0,8,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="最近触发" Style="{StaticResource MutedTextStyle}" />
                                                    <TextBlock Text="{Binding LastTime}" Margin="0,8,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="复盘分析">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="复盘分析" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="用完整交易看清自己的优势与习惯。" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource PageCardStyle}" Padding="10" Margin="0,0,0,8">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="周期" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <ComboBox Width="105" ItemsSource="{Binding ReviewPeriodOptions}" SelectedItem="{Binding SelectedReviewPeriod}" />
                                <TextBlock Text="从" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="10,0,5,0" />
                                <TextBox Width="110" Text="{Binding ReviewFromDateText, UpdateSourceTrigger=LostFocus}" ToolTip="格式：2026-08-01；选择自定义周期后生效" />
                                <TextBlock Text="到" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="8,0,5,0" />
                                <TextBox Width="110" Text="{Binding ReviewToDateText, UpdateSourceTrigger=LostFocus}" ToolTip="格式：2026-09-01；选择自定义周期后生效" />
                                <TextBlock Text="品种" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="10,0,5,0" />
                                <TextBox Width="100" Text="{Binding ReviewSymbolFilter, UpdateSourceTrigger=LostFocus}" ToolTip="留空为全部；例如 XAUUSD.s" />
                                <TextBlock Text="方向" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="10,0,5,0" />
                                <ComboBox Width="76" ItemsSource="{Binding ReviewSideFilterOptions}" SelectedItem="{Binding SelectedReviewSideFilter}" />
                                <Button Content="查询" Command="{Binding RefreshReviewCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Padding="11,5" />
                            </WrapPanel>
                        </Border>
                        <Grid Grid.Row="2" Margin="3,0,3,8">
                            <TextBlock Text="{Binding ReviewRangeText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ReviewSyncText}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" />
                        </Grid>
                        <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0" Visibility="Collapsed">
                            <TabItem Header="绩效统计">
                                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <Border Style="{StaticResource PageCardStyle}" Margin="0,0,0,8" Padding="12"
                                                Visibility="{Binding HasNoReviewTrades, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="这个范围没有完整交易。换一个周期，或等待上方历史同步完成。" Style="{StaticResource MutedTextStyle}" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding ReviewMetrics}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,8,8" Padding="12" MinHeight="88">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                                            <Viewbox Height="27" Stretch="Uniform" StretchDirection="DownOnly"
                                                                     HorizontalAlignment="Left" Margin="0,6,0,3">
                                                                <TextBlock Text="{Binding Value}" ToolTip="{Binding Value}" Foreground="{Binding ValueColor}"
                                                                           FontSize="19" FontWeight="SemiBold" />
                                                            </Viewbox>
                                                            <TextBlock Text="{Binding Hint}" ToolTip="{Binding Hint}"
                                                                       Style="{StaticResource MutedTextStyle}" FontSize="10"
                                                                       TextWrapping="Wrap" MaxHeight="30" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Style="{StaticResource PageCardStyle}" Padding="14" Margin="0,4,0,0">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,11">
                                                    <TextBlock Text="分类速览" Style="{StaticResource SectionTitleStyle}" />
                                                    <TextBlock Text="选择一个维度，只看这一类" Style="{StaticResource MutedTextStyle}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ReviewCategoryPanelTemplate}"
                                                                Height="350" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="行为分析">
                                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <Border Style="{StaticResource PageCardStyle}" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="当前行为状态" Style="{StaticResource SectionTitleStyle}" />
                                                    <TextBlock Text="{Binding BehaviorRiskText}" Foreground="{StaticResource AccentBrush}" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="行为预设" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <ComboBox Width="72" ItemsSource="{Binding BehaviorPresetOptions}" SelectedItem="{Binding SelectedBehaviorPreset}" />
                                                        <Button Content="应用" Command="{Binding ApplyBehaviorPresetCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="8,5" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding BehaviorMetrics}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource PageCardStyle}" Margin="0,0,0,7" Padding="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="0.6*"/><ColumnDefinition Width="0.6*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,4,0,0" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Threshold, StringFormat=阈值 {0}}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Style="{StaticResource PageCardStyle}" Margin="0,3,0,0" Padding="12">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="规则开关与阈值" Style="{StaticResource SectionTitleStyle}" />
                                                    <Button Content="保存行为设置" Command="{Binding SaveBehaviorSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                                            HorizontalAlignment="Right" Padding="10,6" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding BehaviorSettings}" Margin="0,10,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,8,8">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                                                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                <TextBox Grid.Column="2" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Padding="5,3" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="分类表现">
                                <Border Style="{StaticResource PageCardStyle}" Padding="14">
                                    <ContentControl Content="{Binding}"
                                                    ContentTemplate="{StaticResource ReviewCategoryPanelTemplate}" />
                                </Border>
                            </TabItem>
                            <TabItem Header="逐笔归类">
                                <Border Style="{StaticResource PageCardStyle}" Padding="8">
                                    <ListView ItemsSource="{Binding ReviewTrades}"
                                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="开仓" Width="90" DisplayMemberBinding="{Binding Time}" />
                                                <GridViewColumn Header="品种" Width="88" DisplayMemberBinding="{Binding Symbol}" />
                                                <GridViewColumn Header="方向" Width="48" DisplayMemberBinding="{Binding Side}" />
                                                <GridViewColumn Header="净盈亏" Width="72" DisplayMemberBinding="{Binding Pnl}" />
                                                <GridViewColumn Header="计划归类" Width="125">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ComboBox Width="115"
                                                                      ItemsSource="{Binding DataContext.PlanComplianceOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                      SelectedValue="{Binding ComplianceStatus, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="策略" Width="100">
                                                    <GridViewColumn.CellTemplate><DataTemplate><TextBox Width="92" Text="{Binding Strategy, UpdateSourceTrigger=LostFocus}" /></DataTemplate></GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="形态" Width="100">
                                                    <GridViewColumn.CellTemplate><DataTemplate><TextBox Width="92" Text="{Binding Setup, UpdateSourceTrigger=LostFocus}" /></DataTemplate></GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="标签" Width="115">
                                                    <GridViewColumn.CellTemplate><DataTemplate><TextBox Width="107" Text="{Binding Tags, UpdateSourceTrigger=LostFocus}" /></DataTemplate></GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="操作" Width="72">
                                                    <GridViewColumn.CellTemplate><DataTemplate><Button Content="保存" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="7,3" Margin="0" /></DataTemplate></GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Border>
                            </TabItem>
                        </TabControl>
                        <views:ReviewWorkspaceView Grid.Row="3" DataContext="{Binding ReviewWorkspace}" />
                    </Grid>
                </TabItem>

                <TabItem Header="时间线">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="交易时间线" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="每个事实都会记录，历史恢复不会重复弹出提醒。" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource PageCardStyle}" Padding="0">
                            <ListView ItemsSource="{Binding Timeline}"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="时间" Width="105" DisplayMemberBinding="{Binding Time}" />
                                        <GridViewColumn Header="事件" Width="155" DisplayMemberBinding="{Binding Kind}" />
                                        <GridViewColumn Header="记录事实" Width="455" DisplayMemberBinding="{Binding Summary}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="设置中心">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="设置中心" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="调整桌宠行为、交易提醒和终端连接。" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource PageCardStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="桌宠行为" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                                        <CheckBox Content="始终置顶" IsChecked="{Binding IsTopmost}" />
                                        <CheckBox Content="锁定桌宠位置" IsChecked="{Binding IsPositionLocked}" />
                                        <CheckBox Content="鼠标穿透（通过托盘恢复）" IsChecked="{Binding IsMouseThrough}" />
                                        <CheckBox Content="开启专注模式" IsChecked="{Binding IsFocusMode}" />
                                        <CheckBox Content="悬停展开速览（关闭时点击展开）" IsChecked="{Binding ExpandCardOnHover}" />
                                        <CheckBox Content="显示迷你持仓条" IsChecked="{Binding MiniPositionVisible}" />
                                        <CheckBox Content="开机自动启动" IsChecked="{Binding StartWithWindows}" />
                                        <TextBlock Text="桌宠大小" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,5" />
                                        <Slider Minimum="0.4" Maximum="1.5" Value="{Binding PetScale}" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                                        <TextBlock Text="桌宠透明度" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,5" />
                                        <Slider Minimum="0.25" Maximum="1" Value="{Binding PetOpacity}" TickFrequency="0.05" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource PageCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="交易与连接" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14" />
                                        <TextBlock Text="交易终端（保存后下次启动生效）" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding TerminalOptions}" DisplayMemberPath="Label"
                                                  TextSearch.TextPath="Label" IsEditable="False"
                                                  SelectedValuePath="Path" SelectedValue="{Binding SelectedTerminalPath, Mode=TwoWay}"
                                                  ToolTip="选择要读取的交易终端" />
                                        <TextBlock Text="达到目标后的盈利回吐比例" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,7" />
                                        <TextBox Width="150" HorizontalAlignment="Left"
                                                 Text="{Binding GivebackValue, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Text="填写 1–100，例如 50 表示回吐一半时提醒。" Style="{StaticResource MutedTextStyle}" Margin="0,7,0,16" />
                                        <CheckBox Content="每天自动弹出并归档交易日报" IsChecked="{Binding DailyReportEnabled}" />
                                        <TextBlock Text="日报时间（MT5 服务器时间，24 小时制）" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,7" />
                                        <TextBox Width="100" MaxLength="5" HorizontalAlignment="Left"
                                                 Text="{Binding DailyReportTimeText, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Text="直接输入 HH:mm，例如 23:55；不使用下拉菜单。" Style="{StaticResource MutedTextStyle}" Margin="0,7,0,16" />
                                        <Button Content="保存全部设置" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,9" />
                                        <Button Content="安装或更新桥接插件" Command="{Binding InstallBridgeCommand}" Margin="0,0,0,9" />
                                        <Button Content="回放核心交易场景" Command="{Binding ReplayScenarioCommand}" Style="{StaticResource QuietButtonStyle}" Margin="0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource PageCardStyle}" Margin="0,12,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="多段浮亏提醒" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="按当前总浮亏占账户余额的比例触发；回落到阈值下方后才会重新提醒。"
                                                       Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="当前浮亏比例" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding CurrentFloatingLossPercentage, StringFormat={}{0:0.##}%}"
                                                       Foreground="{Binding CurrentFloatingLossPercentageColor}"
                                                       FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding FloatingLossLevels}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0B121B" BorderBrush="#263548" BorderThickness="1"
                                                        CornerRadius="10" Padding="14" Margin="0,0,10,0">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}"
                                                                  FontSize="14" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Row="1" Text="{Binding Hint}" Style="{StaticResource MutedTextStyle}"
                                                                   Margin="0,7,0,12" />
                                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                            <TextBox Width="110" Text="{Binding LossPercentage, UpdateSourceTrigger=LostFocus}"
                                                                     ToolTip="请输入 0.01 到 100 之间的比例" />
                                                            <TextBlock Text="%" FontSize="15" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,14,0,0">
                                        <TextBlock Text="默认三段为 1%、2%、3%；每段都能单独关闭或修改。一次跨过多段时只弹最高一段。"
                                                   Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                                        <Button Content="保存提醒比例" Command="{Binding SaveSettingsCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="#0A1018" BorderBrush="#1D2734" BorderThickness="0,1,0,0" Padding="22,10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding DiagnosticText}" Foreground="#788594" FontSize="11"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
